# Server configuration 
PORT=port
HOST=host
# Database connection
DB_HOST=db_host
DB_USER=db_user
DB_PASS=db_password
DB_NAME=db_name
DB_DIAL='mysql'

MONGO_URI=no_sql_db_uri

MINIO_ENDPOINT=endpoint
MINIO_ROOT_USER=root_user
MINIO_ROOT_PASSWORD=root_pwrd
MINIO_VOLUMES=volumes
MINIO_OPTS=opts

# JWT Configuration - Access Token (short-lived)
JWT_SECRET=jwt_secret_key_min_32_chars
JWT_EXPIRE=15m

# JWT Configuration - Refresh Token (long-lived)
JWT_REFRESH_SECRET=jwt_refresh_secret_key_min_32_chars
JWT_REFRESH_EXPIRE=7d

# Email (Brevo SMTP)
# EMAIL_FROM must be a verified sender/domain in Brevo.
# EMAIL_HOST/EMAIL_PORT are optional (defaults shown).
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=xxxxxxxxx@smtp-brevo.com
EMAIL_SMTP_KEY=xsmtpsib-...
EMAIL_FROM=noreply@sam.pt